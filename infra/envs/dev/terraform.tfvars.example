# Copy to terraform.tfvars (gitignored) and adjust. Every value shown is the default.
# Credentials come from the environment: export AWS_PROFILE=<your-profile>
#
# Defaults = IMPLEMENTATION mode (instructor guidance, proposal feedback Oct 2026):
# one AZ, no NAT gateway, no HA. The HA target design (what the diagram and
# report show) is the commented block at the bottom. See docs/architecture.md.

aws_region  = "ap-southeast-1"
project     = "ticketmastery"
environment = "dev"

# Network / cost toggles
vpc_cidr                 = "10.20.0.0/16" # always 2 public + 2 private subnets (ALB and DB subnet group need 2 AZs)
enable_nat_gateway       = false          # ~USD 43/month per NAT + USD 0.059/GB; only needed for private-subnet tasks or in-VPC Lambdas
single_nat_gateway       = true           # when NAT is on: one NAT in AZ a (false = one per AZ)
enable_gateway_endpoints = true           # S3 + DynamoDB, free
enable_vpc_endpoints     = false          # ecr.api/ecr.dkr/logs/secretsmanager/sqs, ~USD 95/month

# Security
alb_ingress_cidrs        = [] # internal ALB: only the API Gateway VPC link reaches it; ["0.0.0.0/0"] only with alb_internal = false
rds_extra_ingress_sg_ids = [] # e.g. ["sg-0123456789abcdef0"] for a VPC Lambda
certificate_arn          = "" # ACM ARN in ap-southeast-1 enables HTTPS + HTTP->HTTPS redirect

# Auth + API Gateway (Andrew)
alb_integration     = "vpc_link" # or "origin_header" (needs certificate_arn + alb_origin_domain)
alb_internal        = true       # internal ALB with vpc_link (+ alb_ingress_cidrs = []); false only for origin_header
alb_origin_domain   = ""         # origin_header only, e.g. "origin.example.com"
waiting_room_public = false      # true = guests can join the waiting room without signing in

# API services: one image, one ECS service per use case (ecs_services below).
# task_cpu / task_memory / desired_count / autoscaling_*_capacity are defaults for every service;
# a value set in an ecs_services entry wins over them.
image_tag                     = "latest"
container_port                = 3000
task_cpu                      = 256
task_memory                   = 512
cpu_architecture              = "X86_64" # ARM64 if you push arm64 images
tasks_in_public_subnets       = true     # task gets a public IP for egress (no NAT); inbound still only from the ALB SG
tasks_single_az               = true     # tasks only in AZ a
desired_count                 = 1
run_migrations_on_start       = true
auth_mode                     = "dev-header" # MUST be "cognito" once the Cognito authorizer is live
enable_container_health_check = false
container_insights            = "disabled"
log_retention_days            = 14
enable_autoscaling            = false # configurable; off for the implementation
autoscaling_min_capacity      = 1
autoscaling_max_capacity      = 2 # only for services without their own autoscaling_max (the defaults below set it for all)
ecr_force_delete              = true

# One ECS service per use case. discovery is the ALB default (unmatched paths + /health); the others need
# path_patterns and a fixed listener_priority (> 20). Optional per service: desired_count, autoscaling_min,
# autoscaling_max, cpu, memory, tg_short_name. Setting ecs_services replaces the whole map, so copy all five.
ecs_services = {
  discovery    = { modules = ["discovery"], autoscaling_max = 3 }
  account      = { modules = ["account"], path_patterns = ["/api/me", "/api/me/*"], listener_priority = 110, autoscaling_max = 2 }
  waiting-room = { modules = ["waiting-room"], path_patterns = ["/api/waiting-room", "/api/waiting-room/*"], listener_priority = 120, tg_short_name = "wroom", autoscaling_max = 3 }
  checkout     = { modules = ["checkout"], path_patterns = ["/api/checkout", "/api/checkout/*"], listener_priority = 130, autoscaling_max = 3 }
  organiser    = { modules = ["organiser"], path_patterns = ["/api/organiser", "/api/organiser/*"], listener_priority = 140, autoscaling_max = 2 }
}

# RDS (single-AZ; pinned to AZ a automatically while db_multi_az = false)
db_engine_version          = "16"
db_instance_class          = "db.t4g.micro"
db_allocated_storage       = 20
db_multi_az                = false
db_backup_retention_period = 1
db_deletion_protection     = false
db_skip_final_snapshot     = true

# ------------------------------------------------------------------------------
# HA / target design (for the diagram and report; NOT deployed by default).
# Costs roughly USD 190/month instead of ~69 (docs/cost-estimate.md).
# Uncomment to replace the matching lines above:
#
# tasks_in_public_subnets    = false # tasks in private subnets, no public IP
# tasks_single_az            = false # tasks spread across AZ a and AZ b
# enable_nat_gateway         = true
# single_nat_gateway         = false # one NAT per AZ (no cross-AZ dependency)
# # ...or, instead of NAT: enable_vpc_endpoints = true (keep enable_gateway_endpoints = true)
# enable_autoscaling         = true
# autoscaling_min_capacity   = 2     # never scale in below one task per AZ
# autoscaling_max_capacity   = 4     # or more
# desired_count              = 2     # at least one task per AZ
# db_multi_az                = true  # synchronous standby in AZ b; AZ pin is dropped automatically
# db_deletion_protection     = true
# db_backup_retention_period = 7
# ------------------------------------------------------------------------------

# UC5 reporting in QuickSight (infra/envs/dev/quicksight.tf). Billed per user per month while subscribed: follow the
# steps in infra/modules/quicksight/README.md (migration, reporting-user.sh, first apply, console grant, second apply).
enable_quicksight                = false # true = subscribe to Enterprise + VPC connection to RDS
quicksight_secret_access_granted = false # true only after granting QuickSight the reporting secret in the console
# quicksight_account_name        = "ticketmastery-dev-000246635159" # default: <project>-<environment>-<account id>
# quicksight_admin_iam_arn       = "arn:aws:iam::000246635159:user/elroy"
# quicksight_register_admin_user = false # only if Terraform itself runs as quicksight_admin_iam_arn
# quicksight_currency            = "SGD"
