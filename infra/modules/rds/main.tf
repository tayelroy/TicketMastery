resource "aws_db_subnet_group" "this" {
  name        = "${var.name}-db-subnets"
  description = "Private subnets for ${var.name} PostgreSQL"
  subnet_ids  = var.private_subnet_ids

  tags = {
    Name = "${var.name}-db-subnets"
  }
}

# Suffix keeps final snapshot names unique across destroy/recreate cycles.
resource "random_id" "final_snapshot_suffix" {
  byte_length = 4
}

resource "aws_db_instance" "this" {
  identifier = "${var.name}-postgres"

  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = var.db_name
  username = var.username
  port     = var.port

  # RDS generates the master password and stores it in Secrets Manager as
  # JSON {"username": ..., "password": ...}. No plaintext password in code or state.
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [var.rds_sg_id]
  publicly_accessible    = false
  multi_az               = var.multi_az
  # Pins a single-AZ instance to one AZ (null = AWS picks). Must be null when
  # multi_az = true; RDS rejects both together (see the precondition below).
  # Only used at creation: changing the AZ would replace the instance (and its
  # data), and after a Multi-AZ failover the primary can sit in either AZ, so
  # availability_zone is in ignore_changes below.
  availability_zone = var.availability_zone

  # Apply class, Multi-AZ and backup changes now rather than in the next
  # maintenance window.
  apply_immediately = var.apply_immediately

  # Default parameter group for the family; PostgreSQL 15+ defaults rds.force_ssl = 1.

  backup_retention_period = var.backup_retention_period
  copy_tags_to_snapshot   = true
  deletion_protection     = var.deletion_protection

  skip_final_snapshot       = var.skip_final_snapshot
  final_snapshot_identifier = var.skip_final_snapshot ? null : "${var.name}-postgres-final-${random_id.final_snapshot_suffix.hex}"

  auto_minor_version_upgrade   = true
  performance_insights_enabled = false

  tags = {
    Name = "${var.name}-postgres"
  }

  lifecycle {
    ignore_changes = [availability_zone]

    precondition {
      condition     = !(var.multi_az && var.availability_zone != null)
      error_message = "availability_zone must be null when multi_az = true (RDS rejects both together)."
    }
  }
}

# Login of the read-only database role reporting_ro (migration 0004: SELECT on the five report_* views only,
# connection limit 10), used by the reporting ECS service (envs/dev ecs_services.reporting). Here, next to the master
# secret, because it is a credential of this database, and the ecs-service module stays generic (it only takes
# secret ARNs). Terraform creates the secret WITHOUT a value (no aws_secretsmanager_secret_version), so the password
# is never in code or Terraform state: loadtest/scripts/reporting-user.sh gives the role a random password through ECS
# Exec and writes {"username", "password"} here. Deploy order in docs/deploy.md.
resource "aws_secretsmanager_secret" "reporting_ro" {
  name        = "${var.name}/reporting/reporting-ro"
  description = "Login of database role reporting_ro for the reporting ECS service (value written by loadtest/scripts/reporting-user.sh)"
  # Deleted at once on destroy, so a re-created environment can reuse the name; the value is regenerated by the
  # script anyway.
  recovery_window_in_days = 0
}
