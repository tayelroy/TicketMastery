# Copy to .env for `npm run dev` / `npm run migrate:dev` / `npm run seed` on your machine
# (values match the local docker compose Postgres). Never commit .env.
# In AWS, ECS injects these from the task definition; DB_PASSWORD comes from Secrets Manager.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Optional build id (git SHA) reported by /health; defaults to package.json version.
APP_VERSION=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticketmastery
DB_USER=tm
DB_PASSWORD=tm_local_dev_only
# true on RDS
DB_SSL=false
DB_POOL_MAX=10

# dev-header: trust x-dev-user-id / x-dev-user-groups headers (local only).
# cognito: verify Cognito access tokens (needs COGNITO_USER_POOL_ID + COGNITO_CLIENT_ID: terraform output).
AUTH_MODE=dev-header
# Required to run dev-header auth with NODE_ENV=production. Leave false locally.
ALLOW_DEV_AUTH=false
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

RUN_MIGRATIONS_ON_START=false
