flowchart TB
  user([Browser])
  cf["CloudFront + WAF"]
  s3site[(S3 SPA bucket)]
  cognito[Cognito]
  apigw["API Gateway HTTP API<br/>JWT authorizer<br/>100 rps / 200 burst"]

  subgraph vpc["VPC 10.20.0.0/16 - implementation mode (single AZ, no NAT)"]
    vpcl[VPC link]
    subgraph aza["AZ a: everything that runs"]
      subgraph puba["Public subnet a"]
        task["Fargate task x1<br/>0.25 vCPU / 0.5 GB<br/>public IP for egress only,<br/>inbound only from ALB SG"]
      end
      subgraph priva["Private subnet a"]
        alba["Internal ALB node"]
        db[("RDS PostgreSQL 16<br/>db.t4g.micro, single-AZ<br/>20 GB gp3, 1-day PITR")]
        qm["Lambda queue-manager<br/>Python, in VPC"]
      end
    end
    subgraph azb["AZ b: required by ALB and DB subnet group"]
      albb["Internal ALB node"]
      privb["Private subnet b<br/>(empty DB subnet group member)"]
    end
    gwe["S3 + DynamoDB<br/>gateway endpoints (free)"]
    igw[Internet gateway]
  end

  sqsf[[SQS FIFO join-queue]]
  sched["EventBridge Scheduler"]
  ddb[(DynamoDB live-queue)]
  sns[[SNS order-events]]
  sqst[[SQS ticket-queue + DLQ]]
  tfn["Lambda ticket-fn<br/>outside VPC"]
  s3pdf[(S3 tickets/orderId.pdf)]
  ses[SES]
  cw["CloudWatch alarms,<br/>dashboard, SNS alerts"]
  aws["ECR, CloudWatch Logs,<br/>Secrets Manager, Cognito JWKS,<br/>SQS, SNS"]

  user --> cf
  cf --> s3site
  cf -->|"/api/*"| apigw
  user -.-> cognito
  apigw --> vpcl --> alba & albb
  alba --> task
  albb --> task
  task --> db
  task -.->|egress via public IP| igw -.-> aws
  task --> sqsf
  task --> ddb
  task --> sns --> sqst --> tfn
  tfn --> s3pdf
  tfn --> ses
  sched -->|admit run| qm
  sqsf -->|event source mapping| qm
  qm -.-> gwe -.-> ddb
  qm -.->|EMF log -> WaitingRoomSize| cw
