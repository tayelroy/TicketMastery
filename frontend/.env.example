# Copy to .env.local for local overrides. 

# Base URL the browser calls for the API. Leave empty in local dev so requests go to /api on the
# Vite dev server, which proxies them to VITE_DEV_API_PROXY. Set it at build time for AWS
# (e.g. the CloudFront / API Gateway URL from Cody and Andrew).
VITE_API_BASE_URL=

# Dev server only: where the /api and /health proxy forwards to.
VITE_DEV_API_PROXY=http://localhost:3000

# Show the fake login (sends x-dev-user-* headers). Only works while the API runs AUTH_MODE=dev-header.
VITE_AUTH_MODE=dev-header
