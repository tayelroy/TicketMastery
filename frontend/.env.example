# Copy to .env.local for local overrides. 

# Base URL the browser calls for the API. Leave empty in local dev so requests go to /api on the
# Vite dev server, which proxies them to VITE_DEV_API_PROXY. Set it at build time for AWS
# (e.g. the CloudFront / API Gateway URL from Cody and Andrew).
VITE_API_BASE_URL=

# Dev server only: where the /api and /health proxy forwards to. Or the API Gateway URL
# (terraform output -raw api_endpoint) to use the AWS API from the local UI.
VITE_DEV_API_PROXY=http://localhost:3000

# dev-header: fake login (sends x-dev-user-* headers); only works while the API runs AUTH_MODE=dev-header.
# cognito: real sign-up/sign-in (Amplify) and Bearer tokens; needs the two IDs below.
VITE_AUTH_MODE=dev-header

# Cognito user pool + app client (public identifiers, not secrets): terraform output -raw cognito_user_pool_id /
# cognito_user_pool_client_id. In the deploy workflow they come from GitHub repository variables.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
